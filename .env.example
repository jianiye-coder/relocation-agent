# Copy to .env. Never commit credentials.
# Choose ONE LLM provider; all keys are optional for deterministic planning.
ANTHROPIC_API_KEY=
# FLATKEY_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# MOVING_AGENT_MODEL=provider:your-compatible-model
# Photo inventory requires image input support.

GOOGLE_MAPS_API_KEY=
FMCSA_WEB_KEY=

# Active Warp key (PR #7). wak_test_ returns mock data, not live quotes.
WARP_API_KEY=
# Stored only; not automatically used by the application.
WARP_PRODUCTION_API_KEY=

# No FCC/NREL address-level adapter is implemented. No utility key is required.
# QUOTE_CACHE=off

# Legacy standalone delivery scripts only; email is disabled in MVP routes/tools.
EMAIL_MODE=outbox
EMAIL_REDIRECT_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
