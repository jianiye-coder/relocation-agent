# Copy to .env. Never commit credentials.
# Choose ONE LLM provider; all keys are optional for deterministic planning.
ANTHROPIC_API_KEY=
# FLATKEY_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# MOVING_AGENT_MODEL=provider:your-compatible-model
# Photo inventory requires image input support.

GOOGLE_MAPS_API_KEY=
# Rental listing photos are retrieved from Realtor.com through HomeHarvest; no API key is required.
FMCSA_WEB_KEY=

# Explicitly choose which credential the app may use. Keep sandbox for demos.
WARP_MODE=sandbox
# Sandbox key (wak_test_) returns mock data, not live quotes.
WARP_API_KEY=
# Only read when WARP_MODE=production. Production quotes are real rates for the request.
WARP_PRODUCTION_API_KEY=

# Unofficial website prices (off by default; see README): public_storage,uhaul,budget_truck
# ENABLE_UNOFFICIAL_ADAPTERS=

# No FCC/NREL address-level adapter is implemented. No utility key is required.
# QUOTE_CACHE=off

# Legacy standalone delivery scripts only; email is disabled in MVP routes/tools.
EMAIL_MODE=outbox
EMAIL_REDIRECT_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
