# Copy to .env and fill in. Never commit .env.

# LLM agent (optional; without it the planner runs without an LLM)
ANTHROPIC_API_KEY=
# MOVING_AGENT_MODEL=anthropic:claude-sonnet-5

# Address lookup and driving distance (optional; without it we use the free Census geocoder + OSRM)
GOOGLE_MAPS_API_KEY=

# Email: outbox (save files), smtp, or gmail
EMAIL_MODE=outbox
# Send every email to this address instead of the provider (use this for real-send tests)
EMAIL_REDIRECT_TO=

# EMAIL_MODE=smtp (Gmail SMTP: needs 2-Step Verification and an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# EMAIL_MODE=gmail (Gmail API; run scripts/gmail_auth.py to get the refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
